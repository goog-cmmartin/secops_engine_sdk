# Google SecOps Workflow Engine & SDK Configuration
# Copy this file to .env and populate with your Google Cloud & SecOps tenant values.

# Google Cloud Project ID (e.g., your-project-id)
GCP_PROJECT_ID=your-gcp-project-id

# Google SecOps Customer UUID (e.g., 00000000-0000-0000-0000-000000000000)
SECOPS_CUSTOMER_ID=your-secops-customer-id

# Google Cloud Project Number (numeric ID, e.g., 123456789012)
SECOPS_PROJECT_NUMBER=your-gcp-project-number

# Google SecOps Region / Location (defaults to 'us')
SECOPS_REGION=us

# (Optional) Custom API endpoint base
# SECOPS_API_BASE=https://us-chronicle.googleapis.com
