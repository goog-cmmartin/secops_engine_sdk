# Google SecOps Workflow Engine & SDK Configuration
# Copy this file to .env and populate with your Google Cloud & SecOps tenant values.

# Google Cloud Project ID (e.g., your-project-id)
GCP_PROJECT_ID=your-gcp-project-id

# Google SecOps Customer UUID (e.g., 00000000-0000-0000-0000-000000000000)
SECOPS_CUSTOMER_ID=your-secops-customer-id

# Google Cloud Project Number (numeric ID, e.g., 123456789012)
SECOPS_PROJECT_NUMBER=your-gcp-project-number

# Google SecOps Region / Location (defaults to 'us')
SECOPS_REGION=us

# (Optional) Custom API endpoint base
# SECOPS_API_BASE=https://us-chronicle.googleapis.com

# --- Authentication (optional) ---
# Credential strategy. One of: auto (default) | adc | gcloud | static
#   auto   : static token -> google-auth ADC -> gcloud subprocess (recommended)
#   adc    : google-auth Application Default Credentials only
#   gcloud : `gcloud auth application-default print-access-token` subprocess only
#   static : use SECOPS_AUTH_TOKEN only (CI / constrained runners)
# SECOPS_AUTH_MODE=auto

# Explicit OAuth2 bearer token override. Highest priority; no auto-refresh.
# Intended for CI/tests. Must carry the cloud-platform scope.
# SECOPS_AUTH_TOKEN=ya29....
